# Copy this file to .env and fill in the values. NEVER commit .env (it is in .gitignore).
PORT=3000

# Groq (server-side only; the browser never sees this key)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=your_groq_model

# Supabase (browser-safe values only: project URL + anon/publishable key).
# NEVER put the service_role key here or anywhere in this app.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_publishable_key

# PostgreSQL connection string (Supabase: Project Settings > Database). Leave empty to use in-memory storage.
DATABASE_URL=your_postgresql_connection_string
DATABASE_SSL=true

# --- Optional tuning (defaults shown) ---
# CSV_MAX_BYTES=204800       # largest CSV upload accepted by the server (bytes)
# CSV_MAX_ROWS=500           # most data rows accepted (a full 7-day file needs 168)
# UPLOAD_RATE_LIMIT=30       # CSV validate/upload requests per minute per IP
# IGNIS_DATA_DIR=            # folder holding validation.json / backtest.json (default: ./data)
